# Employee Document Vault — Frontend Environment Variables
# Copy this file to .env and fill in the real values.
# .env is git-ignored; .env.example is safe to commit.

# AWS Region where Cognito and API Gateway are deployed
VITE_COGNITO_REGION=ap-south-1

# Cognito User Pool ID  (not a secret — required by the browser to resolve the JWKS endpoint)
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX

# Cognito App Client ID  (not a secret — public identifier sent with every auth request)
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# API Gateway base URL (no trailing slash)
VITE_API_URL=https://<api-id>.execute-api.ap-south-1.amazonaws.com/v1
